# ─────────────────────────────────────────────
# Al-Mizan – Notification Service – Environment Variables
# Copier ce fichier : cp .env.example .env
# NE JAMAIS commiter le fichier .env sur Git
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=8010
API_PREFIX=notification-service/v1

# PostgreSQL – choix : Neon (cloud) OU Docker local
# Option A – Neon :
# DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/notif_db?sslmode=require"
# Option B – Docker local :
DATABASE_URL="postgresql://notif_user:notif_password@localhost:5437/notif_db"

# PostgreSQL Docker (utilisé par le service postgres dans docker-compose)
POSTGRES_DB=notif_db
POSTGRES_USER=notif_user
POSTGRES_PASSWORD=notif_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=
REDIS_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=al_mizan_events
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Queues consumed by this service
RABBITMQ_NOTIF_QUEUE=notification_queue
RABBITMQ_NOTIF_AO_QUEUE=notification_ao_queue
RABBITMQ_NOTIF_SOUMISSION_QUEUE=notification_soumission_queue
RABBITMQ_NOTIF_EVALUATION_QUEUE=notification_evaluation_queue
RABBITMQ_NOTIF_ATTRIBUTION_QUEUE=notification_attribution_queue
RABBITMQ_NOTIF_RECOURS_QUEUE=notification_recours_queue
RABBITMQ_NOTIF_IA_QUEUE=notification_ia_queue
RABBITMQ_NOTIF_AUTH_QUEUE=notification_auth_queue

# Email – SMTP (Configurer avec un relais souverain ou Postfix on-premise)
SMTP_HOST=smtp.example.dz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@almizan.dz
SMTP_PASS=changeme
SMTP_FROM_NAME=Al-Mizan
SMTP_FROM_EMAIL=notifications@almizan.dz

# SMS – Opérateurs Algériens
# Provider SMS agréé (ex: SMS Gateway local conforme ARPCE)
SMS_PROVIDER_URL=https://sms.provider.dz/api/send
SMS_API_KEY=your_api_key_here
SMS_SENDER_ID=AL-MIZAN
# Prefixes opérateurs DZ
SMS_DJEZZY_PREFIXES=07
SMS_OOREDOO_PREFIXES=05
SMS_MOBILIS_PREFIXES=06

# Firebase Cloud Messaging (Push Android)
#FIREBASE_PROJECT_ID=your-firebase-project-id
#FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
#FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# OU utiliser le fichier service account JSON (recommandé en prod)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# pgAdmin (optionnel – dev uniquement)
PGADMIN_EMAIL=admin@almizan.dz
PGADMIN_PASSWORD=admin123

# Swagger
SWAGGER_TITLE=Al-Mizan – Service Notifications
SWAGGER_DESCRIPTION=Microservice de gestion des notifications (email, SMS, push Android, alertes IA)
SWAGGER_VERSION=1.0

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
